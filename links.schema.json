{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oncesports.example/links.schema.json",
  "title": "ONCE Sports — links.json",
  "type": "object",
  "required": ["profile", "links"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "profile": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "url"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "featured": {
            "type": "boolean"
          },
          "enabled": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
